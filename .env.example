# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Anchor (getanchor.co) BaaS
VITE_ANCHOR_API_KEY=your_anchor_sandbox_api_key
VITE_ANCHOR_BASE_URL=https://api.sandbox.getanchor.co/v1

# Maintenance mode — set VITE_MAINTENANCE_MODE=true to show the sitewide
# "back soon" page to everyone. Does not affect api/*.js or Supabase functions.
# Requires a rebuild/redeploy to take effect (Vite env vars are build-time).
VITE_MAINTENANCE_MODE=false
# Optional: override the default bypass path/token below (keep these secret,
# don't commit real values). Visiting the bypass path grants this browser a
# cookie that skips maintenance mode until it expires or you clear cookies.
# VITE_MAINTENANCE_BYPASS_PATH=/preview-9f3k7x2q1a
# VITE_MAINTENANCE_BYPASS_TOKEN=uk7f-2m9x-preview
