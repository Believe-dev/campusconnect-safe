# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1/object/public

# Paystack Configuration
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key

# Encryption Key (Generate a secure random key)
VITE_ENCRYPTION_KEY=your-secure-encryption-key-here

# App Configuration
VITE_APP_NAME=UniMarket
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Security Configuration
VITE_ENABLE_SECURITY_MONITORING=true
VITE_RATE_LIMIT_REQUESTS=100
VITE_RATE_LIMIT_WINDOW=60000